# Copy to .env inside backend/. Required database values must be filled in.
NODE_ENV=development
PORT=3001
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# When true, the database certificate is verified using the system trust store.
DATABASE_SSL=false
# Comma-separated exact web origins; no wildcard, path, or trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required: generate a strong random signing secret (at least 32 characters).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
