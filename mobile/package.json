{
  "name": "ismo-android",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/backend.integration.ts",
    "export": "expo export --platform android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "postinstall": "node scripts/icon.cjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "react-native-screens": "~4.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "@tanstack/react-query": "5.85.5",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-font": "~14.0.12",
    "expo-build-properties": "~1.0.10",
    "@expo/vector-icons": "^15.0.3",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.10",
    "@types/node": "^22.15.29",
    "eslint": "9.39.5",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.20.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
